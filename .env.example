# Copy to .env on the closed deployment host. Never commit the populated file.

# One suffix must be used by key generation, compose key IDs and public registry.
A2A_KEY_SUFFIX=2026-01
A2A_KEYS_DIR=./secrets/a2a

# Ouroboros network passwords (one per agent UI/API).
AGENT1_PASS=change-me-agent1
AGENT2_PASS=change-me-agent2
AGENT3_PASS=change-me-agent3
AGENT4_PASS=change-me-agent4
AGENT5_PASS=change-me-agent5

# Long, unique random bearer tokens for Gateway authentication.
AGENT1_A2A_TOKEN=replace-with-unique-secret-agent1
AGENT2_A2A_TOKEN=replace-with-unique-secret-agent2
AGENT3_A2A_TOKEN=replace-with-unique-secret-agent3
AGENT4_A2A_TOKEN=replace-with-unique-secret-agent4
AGENT5_A2A_TOKEN=replace-with-unique-secret-agent5
